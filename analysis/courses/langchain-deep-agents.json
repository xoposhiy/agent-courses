    {
      "concept_id": "checkpointing",
      "coverage": "taught",
      "evidence": [
        {
          "source_path": "courses/langchain-deep-agents/markdown/lessons/m1.7-messages-threads-checkpointers.md",
          "line": 104,
          "page": null,
          "excerpt": "A **checkpointer** saves thread state between calls. Without a checkpointer, there is nowhere to store the history for later. A `thread_id` is just an address; the checkpointer is the storage system that knows how to save and load whatever’s at that address, and a single checkpointer instance holds many threads at once. For local development, the simplest checkpointer is `MemorySaver()`:",
          "material_id": "lessons/m1.7-messages-threads-checkpointers",
          "category": "lessons",
          "source_url": "https://github.com/langchain-ai/lca-deepagents/blob/HEAD/thinkific/src/m1/m1.7-messages-threads-checkpointers.md",
          "sha256": "32a3e38ca801b803509416cf26801c9e65d316f3ba686b369c90ba95567684ad"
        }
      ]
    },
