{
  "schema_version": "1.0",
  "purpose": "Group the shared course concepts into separate frequency dictionaries.",
  "assignment_rule": "Each canonical concept has exactly one primary category. Related categories are references and do not add counts.",
  "category_axis": "Role in agent development, with technique groups split by the operation they change.",
  "categories": [
    {
      "id": "foundations",
      "title": "Foundations and design concepts",
      "scope": "Core concepts that explain models, agent components, and system design.",
      "boundary": "General concepts and input representations belong here; concrete component arrangements belong under architecture.",
      "subgroups": [
        {
          "id": "agent-design",
          "title": "Agent design"
        },
        {
          "id": "model-fundamentals",
          "title": "Model fundamentals"
        }
      ]
    },
    {
      "id": "architecture",
      "title": "Architectural patterns",
      "scope": "Reusable ways to arrange components, assign control, coordinate agents, and compose execution stages.",
      "boundary": "System structure and control flow belong here. Local prompting, context operations, and runtime recovery mechanisms have separate categories.",
      "subgroups": [
        {
          "id": "control-flow",
          "title": "Control flow and composition"
        },
        {
          "id": "coordination",
          "title": "Delegation and coordination"
        },
        {
          "id": "human-control",
          "title": "Human control"
        }
      ]
    },
    {
      "id": "reasoning-techniques",
      "title": "Prompting, reasoning, and planning techniques",
      "scope": "Ways to guide a model, generate candidates, search reasoning paths, check answers, or improve instructions.",
      "boundary": "Local reasoning operations belong here. A planner-executor split belongs under architecture; factual grounding policy belongs under safety and trust.",
      "subgroups": [
        {
          "id": "prompting",
          "title": "Prompting and output control"
        },
        {
          "id": "reasoning",
          "title": "Reasoning and verification"
        },
        {
          "id": "search",
          "title": "Planning and candidate search"
        }
      ]
    },
    {
      "id": "context-memory",
      "title": "Context and memory techniques",
      "scope": "Ways to select active context, store experience, maintain memory, and reuse skills.",
      "boundary": "Context isolation and tiered memory are information-management patterns. They stay here rather than under system topology. Memory evaluation belongs under evaluation.",
      "subgroups": [
        {
          "id": "context",
          "title": "Context management"
        },
        {
          "id": "memory",
          "title": "Memory representations and maintenance"
        },
        {
          "id": "dialogue",
          "title": "Dialogue context"
        }
      ]
    },
    {
      "id": "retrieval-knowledge",
      "title": "Retrieval, data, and knowledge techniques",
      "scope": "Ways to retrieve evidence, query data, extract structured knowledge, and reconcile information.",
      "boundary": "Preparation of data for weight updates belongs under training. Retrieval metrics belong under evaluation. Research applications remain separate from their methods.",
      "subgroups": [
        {
          "id": "retrieval",
          "title": "Retrieval and indexing"
        },
        {
          "id": "knowledge",
          "title": "Knowledge processing"
        },
        {
          "id": "research",
          "title": "Research information management"
        }
      ]
    },
    {
      "id": "tool-techniques",
      "title": "Tool-use and action techniques",
      "scope": "Ways to define, discover, compose, and execute tools or map observations to actions.",
      "boundary": "Generic tool-use capabilities and methods belong here. MCP and named frameworks belong under tools and protocols. CodeAct as an agent-loop design belongs under architecture.",
      "subgroups": [
        {
          "id": "interfaces",
          "title": "Tool interfaces and selection"
        },
        {
          "id": "execution",
          "title": "Programmatic execution"
        }
      ]
    },
    {
      "id": "training",
      "title": "Model training and adaptation",
      "scope": "Methods, data, learning signals, and systems used to change weights or learn across tasks.",
      "boundary": "Prompt search without weight updates belongs under reasoning techniques. Serving optimizations belong under runtime. RL systems stay here because their purpose is training.",
      "subgroups": [
        {
          "id": "adaptation",
          "title": "Training and adaptation"
        },
        {
          "id": "rl-methods",
          "title": "RL learning signals and systems"
        },
        {
          "id": "training-data",
          "title": "Training data and risks"
        }
      ]
    },
    {
      "id": "evaluation",
      "title": "Evaluation, research, and improvement",
      "scope": "Ways to define expected behavior, measure agents, validate judges, analyze failures, and test improvements.",
      "boundary": "A composed evaluator-optimizer loop belongs under architecture. Graders, experiments, and failure analyses belong here. Runtime tracing has a cross-reference from runtime.",
      "subgroups": [
        {
          "id": "measurement",
          "title": "Requirements and measurement"
        },
        {
          "id": "graders",
          "title": "Graders and judge validation"
        },
        {
          "id": "improvement",
          "title": "Analysis and improvement"
        },
        {
          "id": "research-methods",
          "title": "Research methods"
        }
      ]
    },
    {
      "id": "safety-trust",
      "title": "Safety, security, and trust",
      "scope": "Risks, protections, evidence requirements, and uncertainty policies that limit harmful or unsupported behavior.",
      "boundary": "Approval gates belong under architecture because they change control flow. Memory namespaces remain under memory. Direct security and trust requirements belong here.",
      "subgroups": [
        {
          "id": "security",
          "title": "Threats and protections"
        },
        {
          "id": "trust",
          "title": "Evidence and uncertainty"
        }
      ]
    },
    {
      "id": "runtime",
      "title": "Runtime, deployment, and performance",
      "scope": "Execution infrastructure, persistence, recovery, service operation, and inference cost or speed.",
      "boundary": "These mechanisms support execution rather than define agent-team topology. Named products and protocols are separate. Training infrastructure stays under training.",
      "subgroups": [
        {
          "id": "execution",
          "title": "Execution infrastructure"
        },
        {
          "id": "persistence",
          "title": "Persistence and recovery"
        },
        {
          "id": "performance",
          "title": "Serving and performance"
        }
      ]
    },
    {
      "id": "tools-protocols",
      "title": "Named tools, frameworks, and protocols",
      "scope": "Named implementation technologies and interoperability standards.",
      "boundary": "Products and standards belong here. Generic framework design, tool-use concepts, and implementation methods remain separate.",
      "subgroups": [
        {
          "id": "frameworks",
          "title": "Frameworks and hosting"
        },
        {
          "id": "protocols",
          "title": "Protocols"
        }
      ]
    },
    {
      "id": "applications",
      "title": "Application areas",
      "scope": "Types of tasks and domains where an agent is applied.",
      "boundary": "An application describes the work an agent does. Its reasoning, architecture, or evaluation is classified separately. Persona and style control is a prompting technique.",
      "subgroups": [
        {
          "id": "software",
          "title": "Software and interface work"
        },
        {
          "id": "research-data",
          "title": "Research and data work"
        },
        {
          "id": "domains",
          "title": "Domain assistants and simulations"
        }
      ]
    },
    {
      "id": "behavior",
      "title": "Agent behavior, human interaction, and interpretability",
      "scope": "Human-agent interaction, social behavior, cognitive questions, and methods for inspecting internal model behavior.",
      "boundary": "Approval gates belong under architecture. Task success tests belong under evaluation. This category concerns interaction and the behavior or internal mechanisms being studied.",
      "subgroups": [
        {
          "id": "human-interaction",
          "title": "Human-agent interaction"
        },
        {
          "id": "social-behavior",
          "title": "Social behavior"
        },
        {
          "id": "cognition",
          "title": "Cognitive questions"
        },
        {
          "id": "interpretability",
          "title": "Mechanistic interpretation"
        }
      ]
    }
  ],
